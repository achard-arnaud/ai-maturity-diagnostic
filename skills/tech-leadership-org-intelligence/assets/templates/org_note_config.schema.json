{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technology leadership organisation note",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "executive_thesis",
    "executive_summary",
    "method_notes",
    "legal_structure",
    "orgchart",
    "power_map",
    "raci",
    "people",
    "influence_map",
    "contact_order",
    "unknowns",
    "sources"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["company", "title", "subtitle", "date", "evidence_cutoff", "purpose", "disclaimer"],
      "properties": {
        "company": {"type": "string"},
        "note_number": {"type": "integer", "minimum": 1},
        "title": {"type": "string"},
        "subtitle": {"type": "string"},
        "date": {"type": "string"},
        "evidence_cutoff": {"type": "string", "format": "date"},
        "keywords": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
        "purpose": {"type": "string"},
        "disclaimer": {"type": "string"}
      }
    },
    "executive_thesis": {"type": "string"},
    "executive_summary": {"$ref": "#/$defs/rows"},
    "method_notes": {"type": "array", "items": {"type": "string"}},
    "legal_structure": {"$ref": "#/$defs/rows"},
    "orgchart": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "tier"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "label": {"type": "string"},
              "tier": {"enum": ["governance", "business", "technology", "control", "transition", "unknown", "federated"]}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "string"},
              {"type": "string"},
              {"enum": ["solid", "dashed"]}
            ],
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "power_map": {"$ref": "#/$defs/rows"},
    "raci": {
      "type": "object",
      "required": ["headers", "rows"],
      "properties": {
        "headers": {"type": "array", "items": {"type": "string"}},
        "rows": {"$ref": "#/$defs/rows"}
      }
    },
    "people": {"type": "array", "minItems": 1, "items": {"$ref": "person_record.schema.json"}},
    "influence_map": {"$ref": "#/$defs/rows"},
    "contact_order": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_type", "title", "publisher", "publication_or_access_date", "url", "supports_fields"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{2,}$"},
          "source_type": {"type": "string"},
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "publication_or_access_date": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "supports_fields": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "rows": {
      "type": "array",
      "items": {"type": "array", "items": {"type": ["string", "number", "boolean"]}}
    }
  }
}
